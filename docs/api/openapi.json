    "components": {
        "securitySchemes": {
            "http": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "CompanyResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "template": {
                        "$ref": "#/components/schemas/CompanyTemplate"
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "template",
                    "created_at",
                    "updated_at"
                ],
                "title": "CompanyResource"
            },
            "CompanyTemplate": {
                "type": "string",
                "description": "Configuration de d\u00e9part d'une entreprise (RM-02).\n",
                "enum": [
                    "blank",
                    "studio"
                ],
                "title": "CompanyTemplate"
            },
            "LifecycleStatus": {
                "type": "string",
                "description": "\u00c9tat d'un poste ou d'un agent : en brouillon ou en service.\n",
