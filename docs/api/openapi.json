                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "token": {
                                            "type": "string"
                                        },
                                        "user": {
                                            "allOf": [
                                                {
                                                    "$ref": "#/components/schemas/UserResource"
                                                },
                                                {
                                                    "type": "object",
                                                    "required": [
                                                        "company"
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    "required": [
